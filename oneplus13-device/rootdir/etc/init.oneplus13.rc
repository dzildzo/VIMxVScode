on early-init
    start ueventd

on init
    # Set permissions for various devices
    chown root system /sys/class/leds/led:flash_0/brightness
    chmod 0660 /sys/class/leds/led:flash_0/brightness
    
    # Set default CPU governors
    write /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor schedutil
    write /sys/devices/system/cpu/cpu4/cpufreq/scaling_governor schedutil
    write /sys/devices/system/cpu/cpu7/cpufreq/scaling_governor schedutil

on boot
    # Set system properties
    setprop ro.product.device oneplus13
    setprop ro.product.model SM8750
    setprop ro.vendor.oneplus.device oneplus13
    
    # Enable ART optimizations
    setprop dalvik.vm.dex2oat-flags --no-watch-dog

service vendor.audio-hal /vendor/bin/hw/android.hardware.audio@7.1-service-mediatek
    class hal
    user audio
    group audio
    ioprio rt 4
    restart_on_failure
