# fstab configuration for OnePlus 13

/dev/block/bootdevice/by-name/boot      /boot       ext4    defaults                                                                 wait,check
/dev/block/bootdevice/by-name/recovery  /recovery   ext4    defaults                                                                 wait,check
/dev/block/bootdevice/by-name/system    /system     ext4    ro,barrier=1,noauto_da_alloc                                             wait,verify
/dev/block/bootdevice/by-name/vendor    /vendor     ext4    ro,barrier=1                                                             wait,verify
/dev/block/bootdevice/by-name/userdata  /data       f2fs    nosuid,nodev,noatime,discard,inline_xattr,inlinecrypt,alloc_last_block   wait,check,formattable,encryptable=footer
/dev/block/bootdevice/by-name/cache     /cache      ext4    nosuid,nodev,noatime,discard                                             wait,check
/dev/block/bootdevice/by-name/persist   /persist    ext4    nosuid,nodev,noatime                                                     wait,check
/dev/block/bootdevice/by-name/modem     /firmware   vfat    ro,context=u:object_r:firmware_file:s0                                  wait,check

# Swap
/dev/block/zram0 none swap zram size=2G                                                        pri=32758
